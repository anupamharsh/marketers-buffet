# Copy to .env.local (local) and add the same names in Netlify's environment
# variables (live). NEXT_PUBLIC_* values are visible in the browser by design.
# Everything else is secret: never commit or share it. See docs/SETUP.md.

# ── Site ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase: database (docs/SETUP.md step 2) ────────────────────────
# Transaction pooler (port 6543): used by the running site
DATABASE_URL=
# Session pooler (port 5432): used only to create/update tables
DATABASE_URL_MIGRATE=

# ── Supabase: sign-in (Project Settings → API) ───────────────────────
# Same URL as SUPABASE_URL. The anon key is public by design.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Comma-separated emails allowed to use /admin (comment approval)
ADMIN_EMAILS=
# ── Supabase: storage ────────────────────────────────────────────────
SUPABASE_URL=
# Storage keys. Also used to sign short-lived download links for paid files.
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_MEDIA=media
S3_BUCKET_FILES=template-files


# ── Bot protection + rate limiting (step 3) ──────────────────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Random string. IPs are stored only as hash(IP + salt), never raw.
IP_HASH_SALT=

# ── Email: Brevo (step 4) ────────────────────────────────────────────
BREVO_API_KEY=
BREVO_LIST_ID=
# Leave empty until the domain sender is verified
BREVO_SENDER_EMAIL=
BREVO_REPLY_TO=marketersbuffet@gmail.com

# ── Payments: Razorpay (step 5) ──────────────────────────────────────
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Booking: Cal ID (step 6) ─────────────────────────────────────────
NEXT_PUBLIC_CAL_INTRO_URL=
NEXT_PUBLIC_CAL_PAID_URL=
# Secret you type into the Cal ID webhook (fills Account › My calls)
CAL_WEBHOOK_SECRET=

# ── Cron keep-alive (step 7) ─────────────────────────────────────────
CRON_SECRET=

# ── Analytics (step 8). GTM loads only after cookie consent. ─────────
NEXT_PUBLIC_GTM_ID=
